# The bug-finding checks only. Style is the compiler's job here and the house rules' job in review; this
# file exists to catch defects, so a check that argues about taste is off rather than argued with.
#
# Every exclusion below is a check that fires on correct code in this tree. If one starts finding real
# defects, turn it back on -- none of them are off because the findings were tedious.
Checks: >
  -*,
  bugprone-*,
  clang-analyzer-*,
  performance-*,
  misc-*,
  -clang-analyzer-optin.core.EnumCastOutOfRange,
  -bugprone-easily-swappable-parameters,
  -bugprone-signed-bitwise,
  -misc-include-cleaner,
  -misc-unused-parameters,
  -misc-no-recursion,
  -misc-non-private-member-variables-in-classes

# Klip's own headers. SDL, Dear ImGui, FFmpeg, PipeWire and tge-core are not ours to fix, and tge-core's
# enums trip performance-enum-size from here.
HeaderFilterRegex: 'src/(app|bus|capture|config|desktop|encode|json|recorder)/'

# clang-analyzer-optin.core.EnumCastOutOfRange: PipeWire, FFmpeg and libva flag enums are meant to be
#   OR'd, and every OR produces a value that is not a named enumerator.
# bugprone-easily-swappable-parameters: every (width, height) and (x, y) pair trips it.
# bugprone-signed-bitwise: PipeWire, FFmpeg and Dear ImGui take their flags as plain int, so every OR of
#   them is signed.
# misc-include-cleaner: 448 findings, and it disagrees with the include rules this project follows.
# misc-unused-parameters: callback and override signatures are mandated by the interface they implement.
